# 复制为 /opt/brandshow/.env 并填入实际值
# 注意：不要提交到 git

# === 后端镜像（CI 自动更新，首次手填 latest）===
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/brandshow-backend:latest

# === 数据库（复用 newsfeed 的 postgres 容器）===
# brandshow 使用独立的 database，与 newsfeed 数据库隔离
POSTGRES_USER=brandshow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=brandshow

# === 服务配置 ===
ENVIRONMENT=production
CORS_ORIGINS=*
